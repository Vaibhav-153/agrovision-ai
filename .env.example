# Copy this file to .env for local use. Never commit .env.
APP_NAME=AgroVision AI
APP_VERSION=1.0.0
PORT=7860
SERVER_NAME=0.0.0.0
LOG_LEVEL=INFO

# Roboflow Serverless Cloud API
ROBOFLOW_API_URL=https://serverless.roboflow.com
ROBOFLOW_MODEL_ID=vaibhav-admane/crop-or-weed-detection-jnmzz-1-yolo11n-t1
ROBOFLOW_API_KEY=
ROBOFLOW_CLASS_MAP={"0":"crop","1":"weed"}

# Inference controls. These are operating defaults, not proven-optimal thresholds.
MODEL_CONFIDENCE=0.50
MODEL_IOU=0.50
MAX_DETECTIONS=100

# Input protection
MAX_UPLOAD_MB=10
MAX_IMAGE_PIXELS=25000000
MAX_IMAGE_SIDE=8000

# Basic per-process burst protection for public demos.
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
